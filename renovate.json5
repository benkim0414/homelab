{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "automerge": false,
  "ignoreUnstable": true,
  "separateMajorMinor": true,
  "schedule": ["at any time"],
  "timezone": "Australia/Melbourne",
  "argocd": {
    "managerFilePatterns": ["/^argocd/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(?:argocd|gerrit|herdr|hermes|hindsight|home-assistant|immich|kube-vip|langfuse|longhorn|metallb|monitoring|openclaw|renovate|tailscale|traefik|vaultwarden)/.+\\.ya?ml$/"]
  },

  "ignorePaths": ["**/examples/**", "**/node_modules/**", "**/.worktrees/**", "**/.renovate-validation/**"],
  "customDatasources": {
    "herdr-amd64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/herdrdev/herdr/releases/latest",
      "format": "json",
      "transformTemplates": ["{\"releases\":[{\"version\":$substringAfter(tag_name,\"v\"),\"digest\":assets[name=\"herdr-linux-x86_64\"].digest}]}"]
    },
    "herdr-arm64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/herdrdev/herdr/releases/latest",
      "format": "json",
      "transformTemplates": ["{\"releases\":[{\"version\":$substringAfter(tag_name,\"v\"),\"digest\":assets[name=\"herdr-linux-aarch64\"].digest}]}"]
    },
    "herdr-core-amd64": {
      "defaultRegistryUrlTemplate": "https://releases.herdr.dev/core/latest.json",
      "format": "json",
      "transformTemplates": ["{\"releases\":[{\"version\":version,\"digest\":\"sha256:\" & targets.\"linux-x86_64\".sha256}]}"]
    },
    "herdr-core-arm64": {
      "defaultRegistryUrlTemplate": "https://releases.herdr.dev/core/latest.json",
      "format": "json",
      "transformTemplates": ["{\"releases\":[{\"version\":version,\"digest\":\"sha256:\" & targets.\"linux-aarch64\".sha256}]}"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^herdr/image/releases\\.json$/"],
      "matchStrings": ["\"(?<depName>herdr(?:-core)?-(?:amd64|arm64))\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[0-9.]+)\",\\s*\"digest\":\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\"\\s*\\}"],
      "datasourceTemplate": "custom.{{depName}}",
      "versioningTemplate": "semver-coerced"
    },
    {
      // helm-values does not extract a separate digest field in this version.
      "customType": "regex",
      "managerFilePatterns": ["/^monitoring/loki-values\\.yaml$/"],
      "matchStrings": ["  image:\\s*\\n    registry: docker.io\\s*\\n    repository: grafana/loki\\s*\\n    tag: (?<currentValue>[\\d.]+)\\s*\\n    digest: (?<currentDigest>sha256:[a-f0-9]{64})"],
      "depNameTemplate": "docker.io/grafana/loki",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "  image:\n    registry: docker.io\n    repository: grafana/loki\n    tag: {{newValue}}\n    digest: {{newDigest}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hindsight/values\\.yaml$/"],
      "matchStrings": ["controlPlane:\\s*\\n  enabled: true\\s*\\n  image:\\s*\\n    tag: (?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "depNameTemplate": "ghcr.io/vectorize-io/hindsight-control-plane",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^langfuse/values\\.yaml$/"],
      "matchStrings": ["  image:\\s*\\n    tag: \"(?<currentValue>[\\d.]+)\"", "  web:\\s*\\n    image:\\s*\\n      tag: \"(?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""],
      "depNameTemplate": "docker.langfuse.com/langfuse/langfuse",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^langfuse/values\\.yaml$/"],
      "matchStrings": ["  worker:\\s*\\n    image:\\s*\\n      tag: \"(?<currentValue>[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""],
      "depNameTemplate": "docker.langfuse.com/langfuse/langfuse-worker",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      // Immich server image tag in Helm values (non-standard path)
      "customType": "regex",
      "managerFilePatterns": ["/^immich/values\\.yaml$/"],
      "matchStrings": [
        "tag:\\s*(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "ghcr.io/immich-app/immich-server",
      "datasourceTemplate": "docker"
    },
    {
      // kube-vip image tag in Helm values
      "customType": "regex",
      "managerFilePatterns": ["/^kube-vip/values\\.yaml$/"],
      "matchStrings": [
        "tag:\\s*\"(?<currentValue>v[\\d.]+)\""
      ],
      "depNameTemplate": "ghcr.io/kube-vip/kube-vip",
      "datasourceTemplate": "docker"
    },
    {
      // Vaultwarden server image tag in Helm values (chart supplies repository)
      "customType": "regex",
      "managerFilePatterns": ["/^vaultwarden/values\\.yaml$/"],
      "matchStrings": [
        "image:\\s*\\n\\s*tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "docker.io/vaultwarden/server",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      // Compare the +k3s revision as a build number, not ignored semver metadata.
      "customType": "regex",
      "managerFilePatterns": ["/^k3s-ansible/inventory\\.yml$/"],
      "matchStrings": ["k3s_version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Operator-approved automatic Herdr TUI/Core releases; other apps stay manual",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["herdr/image/releases.json"],
      "matchPackageNames": ["herdr-amd64", "herdr-arm64", "herdr-core-amd64", "herdr-core-arm64"],
      "groupName": "herdr releases",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Herdr is a manually built and smoke-tested commit image, not a latest tag",
      "matchFileNames": ["herdr/**"],
      "matchPackageNames": ["ghcr.io/benkim0414/hermes-herdr"],
      "enabled": false
    },
    {
      "description": "Preserve the reviewed Loki chart hold; runtime proposals remain separate",
      "matchManagers": ["argocd"],
      "matchFileNames": ["argocd/apps/monitoring.yaml"],
      "matchPackageNames": ["loki"],
      "enabled": false
    },
    {
      "description": "Gerrit patch proposals still require Java, schema, reindex and cold-site recovery review",
      "matchFileNames": ["gerrit/**"],
      "matchPackageNames": ["docker.io/gerritcodereview/gerrit"],
      "allowedVersions": "/^3\\.14\\.\\d+$/",
      "prBodyNotes": ["Update the declared site version and regenerate Gerrit configuration/checksum. Review Java/Gitiles compatibility, schema/reindex and full cold-site backup/restore before deployment; never edit site markers to bypass migration guards."]
    },
    {
      "description": "Preserve the Gerrit proxy's Alpine image variant and release line",
      "matchFileNames": ["gerrit/**"],
      "matchPackageNames": ["docker.io/nginxinc/nginx-unprivileged"],
      "allowedVersions": "/^1\\.28\\.\\d+-alpine$/"
    },
    {
      "description": "Review Langfuse chart and explicit web/worker overrides together",
      "matchPackageNames": ["langfuse", "docker.langfuse.com/langfuse/**"],
      "groupName": "langfuse",
      "prBodyNotes": ["Review startup migrations and coordinated PostgreSQL/ClickHouse/SeaweedFS/Valkey recovery. The disposable-data stance is not a verified durable backup. Preserve stable keys and ClickHouse ARM64 placement."]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.langfuse.com/langfuse/**"],
      "allowedVersions": "/^4\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Preserve Langfuse PostgreSQL 18 and unsuffixed image variant",
      "matchDatasources": ["docker"],
      "matchFileNames": ["langfuse/**"],
      "matchPackageNames": ["postgres"],
      "versioning": "docker",
      "allowedVersions": "/^18(?:\\.\\d+){0,2}$/",
      "groupName": "langfuse-postgresql"
    },
    {
      "description": "Keep Langfuse Valkey on its reviewed 8.0 release line",
      "matchDatasources": ["docker"],
      "matchFileNames": ["langfuse/**"],
      "matchPackageNames": ["docker.io/valkey/valkey"],
      "allowedVersions": "/^8\\.0(?:\\.\\d+)?$/",
      "groupName": "langfuse-valkey"
    },
    {
      "description": "Keep ClickHouse on its reviewed 26.8 release line",
      "matchDatasources": ["docker"],
      "matchFileNames": ["langfuse/**"],
      "matchPackageNames": ["clickhouse/clickhouse-server"],
      "allowedVersions": "/^26\\.8\\.\\d+\\.\\d+$/",
      "groupName": "langfuse-clickhouse"
    },
    {
      "description": "Keep SeaweedFS server and bucket hook aligned on major 4",
      "matchDatasources": ["docker"],
      "matchFileNames": ["langfuse/**"],
      "matchPackageNames": ["chrislusf/seaweedfs"],
      "allowedVersions": "/^4\\.\\d+(?:\\.\\d+)?$/",
      "groupName": "langfuse-objectstore"
    },
    {
      "description": "Group Immich packages together",
      "matchPackageNames": ["ghcr.io/immich-app/**"],
      "groupName": "immich",
      "prBodyNotes": [
        "**Reminder:** Ensure the PostgreSQL backup CronJob has run recently before merging. Check with: `kubectl get jobs -n immich -l app=immich-pg-backup --sort-by=.status.startTime`"
      ]
    },
    {
      "description": "Group Hindsight chart and API images",
      "matchPackageNames": ["ghcr.io/vectorize-io/**"],
      "groupName": "hindsight",
      "prBodyNotes": ["Review chart/API compatibility and verify a recent successful Hindsight PostgreSQL backup before rollout."]
    },
    {
      "description": "Group kube-vip chart and image",
      "matchPackageNames": ["kube-vip", "ghcr.io/kube-vip/kube-vip"],
      "groupName": "kube-vip"
    },
    {
      "description": "Group Home Assistant packages",
      "matchPackageNames": ["home-assistant"],
      "groupName": "home-assistant"
    },
    {
      "description": "Group Vaultwarden packages",
      "matchPackageNames": ["vaultwarden", "docker.io/vaultwarden/server"],
      "groupName": "vaultwarden"
    },
    {
      "description": "Preserve Immich PostgreSQL 16 and its vector extension variant",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "versioning": "docker",
      "allowedVersions": "/^16(?:\\.\\d+){0,2}-vectorchord0\\.4\\.3-pgvectors0\\.2\\.0$/",
      "prBodyNotes": ["Database engine major and vector extension changes require a separately reviewed migration. Keep database and pg_dump images aligned."]
    },
    {
      "description": "Freeze the retained Immich PostgreSQL 14 rollback workload",
      "matchFileNames": ["immich/postgresql.yaml", "immich/migration/**"],
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    {
      "description": "Preserve Hindsight PostgreSQL 17 and Bookworm image variant",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["pgvector/pgvector"],
      "versioning": "docker",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+-pg17-bookworm$/",
      "groupName": "hindsight-postgresql",
      "prBodyNotes": ["Verify a recent successful PostgreSQL backup and pgvector compatibility before rollout. Engine major and OS variant changes require a separately reviewed migration; keep database and pg_dump images aligned."]
    },
    {
      "description": "Keep K3s upgrades separately reviewed",
      "matchPackageNames": ["k3s-io/k3s"],
      "prBodyNotes": ["Review the K3s upgrade runbook and supported version-skew/upgrade path, including bundled Traefik changes. Merging this inventory pin does not execute a node upgrade."]
    }
  ]
}
