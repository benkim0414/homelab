[gerrit]
    basePath = git
    canonicalWebUrl = https://gerrit.tailbd291c.ts.net/
[index]
    type = LUCENE
[auth]
    type = HTTP
    httpHeader = X-Gerrit-User
    httpEmailHeader = X-Gerrit-Email

    httpTrustedProxyNetworks = 127.0.0.1/32
    trustContainerAuth = true
    loginUrl = /login/
[httpd]
    listenUrl = proxy-https://127.0.0.1:8081/
[sshd]
    listenAddress = off
[sendemail]
    enable = false
[cache]
    directory = cache
[plugins]
    allowRemoteAdmin = false
[receive]
    enableSignedPush = false
[download]
    scheme = http
    command = checkout
    command = pull
    command = cherry_pick
