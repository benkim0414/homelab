{
  "mcpServers": {
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@latest"]
    },
    "grafana": {
      "command": "mcp-grafana",
      "args": [],
      "env": {
        "GRAFANA_URL": "http://192.168.0.203",
        "GRAFANA_TOKEN": "$GRAFANA_TOKEN"
      }
    },
    "argocd": {
      "command": "npx",
      "args": ["-y", "argocd-mcp@latest", "stdio"],
      "env": {
        "ARGOCD_BASE_URL": "http://192.168.0.202",
        "ARGOCD_API_TOKEN": "$ARGOCD_API_TOKEN"
      }
    }
  }
}
